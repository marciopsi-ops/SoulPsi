rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-:@|.]+$');
    }
    
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'marciopsi@elosolucoeshumanas.com')
      );
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // --- Admins ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if isAdmin();
      allow create: if isSignedIn(); // allow bootstrap
      allow update, delete: if false; 
    }

    // --- Admin Settings ---
    match /admin_settings/{settingId} {
      allow read: if (settingId == "stripe_private") ? isAdmin() : (isSignedIn() || true);
      allow create, update, delete: if isAdmin();
    }

    // --- Allowed Users ---
    match /allowed_users/{email} {
      allow get: if isSignedIn() && ((request.auth.token.email != null && request.auth.token.email.lower() == email.lower()) || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // --- Profile ---
    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.updatedAt == request.time
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128 && (data.userId == request.auth.uid || isAdmin())))
        && data.get('title', '') is string && data.get('title', '').size() <= 100
        && data.get('about', '') is string && data.get('about', '').size() <= 2000
        && (data.get('specialties', []) is list && data.get('specialties', []).size() <= 20 && (data.get('specialties', []).size() == 0 || data.get('specialties', [])[0] is string))
        && data.get('whatsapp', '') is string && data.get('whatsapp', '').size() <= 20
        && data.get('coverPhoto', '') is string && data.get('coverPhoto', '').size() <= 600000
        && data.get('profilePhoto', '') is string && data.get('profilePhoto', '').size() <= 600000
        && data.get('calendarSync', false) is bool
        && data.get('driveSync', false) is bool
        && data.get('subscriptionStatus', 'active') is string && data.get('subscriptionStatus', 'active') in ['active', 'past_due', 'canceled', 'trial', 'pending']
        && (data.get('materials', []) is list && data.get('materials', []).size() <= 50 && (data.get('materials', []).size() == 0 || (data.get('materials', [])[0] is map || data.get('materials', [])[0] is string)))
        && data.get('billingAccountsStr', '') is string && data.get('billingAccountsStr', '').size() <= 60000
        && (data.get('services', []) is list && data.get('services', []).size() <= 20)
        && data.get('crp', '') is string && data.get('crp', '').size() <= 100
        && data.get('cpf', '') is string && data.get('cpf', '').size() <= 100
        && data.get('email', '') is string && data.get('email', '').size() <= 150
        && data.get('whatsappReminderTemplate', '') is string && data.get('whatsappReminderTemplate', '').size() <= 5000
        && data.get('whatsappFinancialTemplate', '') is string && data.get('whatsappFinancialTemplate', '').size() <= 5000
        && data.get('whatsappBirthdayTemplate', '') is string && data.get('whatsappBirthdayTemplate', '').size() <= 5000
        && data.get('whatsappOtherTemplate', '') is string && data.get('whatsappOtherTemplate', '').size() <= 5000
        && data.get('adminNotes', '') is string && data.get('adminNotes', '').size() <= 10000
        && data.get('autoNotifEnabled', false) is bool
        && data.get('autoNotifPeriod', '') is string && data.get('autoNotifPeriod', '').size() <= 50
        && data.get('autoNotifFrequency', '') is string && data.get('autoNotifFrequency', '').size() <= 50
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is string || data.createdAt is timestamp);
    }

    match /profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      
      allow create: if isOwner(profileId) 
                    && isValidId(profileId)
                    && isValidProfile(incoming());
                    
      allow update: if isValidId(profileId) && (
                      (isOwner(profileId) && isValidProfile(incoming())) ||
                      isAdmin()
                    );
                    
      allow delete: if isAdmin() || isOwner(profileId);
    }

    // --- Reviews ---
    match /profiles/{profileId}/reviews/{reviewId} {
      allow get, list: if isValidId(profileId) && (isOwner(profileId) || existing().status == 'approved' || isAdmin());
      
      allow create: if isValidId(profileId) && isValidId(reviewId) 
                    && (
                      (incoming().status == 'pending' && exists(/databases/$(database)/documents/profiles/$(profileId))) ||
                      isAdmin()
                    );

      allow update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
    }

    // --- Clients ---
    match /profiles/{profileId}/clients/{clientId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      
      allow create: if (isValidId(profileId) && isValidId(clientId)
                    && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    // --- Appointments ---
    match /profiles/{profileId}/appointments/{appointmentId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      
      allow create: if (isValidId(profileId) && isValidId(appointmentId)
                    && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    // --- Signatures ---
    match /profiles/{profileId}/signatures/{signatureId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      
      allow create: if (isValidId(profileId) && isValidId(signatureId)
                    && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    // --- Companies ---
    match /profiles/{profileId}/companies/{companyId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      
      allow create: if (isValidId(profileId) && isValidId(companyId)
                    && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    // --- Company Appointments ---
    match /profiles/{profileId}/companyAppointments/{appointmentId} {
      allow get, list, create, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
    }

    // --- Interactions ---
    function isValidInteraction(data) {
      return data.keys().hasAll(['type', 'timestamp'])
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 1000) || (data.details is map))
        && (!('audience' in data) || data.audience == null || (data.audience is string && data.audience.size() <= 100))
        && data.timestamp == request.time;
    }

    match /profiles/{profileId}/interactions/{interactionId} {
      allow get, list, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      
      allow create: if (isValidId(profileId) && isValidId(interactionId)
                    && isValidInteraction(incoming())) || isAdmin();
      
      allow update: if false; // Interactions are immutable
    }

    // --- Custom Notifications & System Notifications ---
    match /profiles/{profileId}/notifications/{notifId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      allow create: if (isValidId(profileId) && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    match /profiles/{profileId}/system_notifications/{notifId} {
      allow get, list, update, delete: if (isOwner(profileId) || isAdmin()) && isValidId(profileId);
      allow create: if (isValidId(profileId) && exists(/databases/$(database)/documents/profiles/$(profileId))) || isAdmin();
    }

    // --- Backups History ---
    match /backups_history/{backupId} {
      allow read, write: if isAdmin();
    }

    // --- Stripe Logs ---
    match /stripe_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
